meta {
  name: Get Client
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/clients
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("devuelve Hello World", function() {
    expect(res.getBody()).to.equal("Hello World");
  });
}
